# ====== HUGGING FACE CONFIGURATION (optional) ======
# Without a token the app works: every estimate comes from the rule-based fallback.
# To use the AI model:
#  1. Create a token at https://huggingface.co/settings/tokens with the "Inference" preset
#     ("Make calls to Inference Providers"), which is what the backend uses.
#  2. Put it here, with no spaces or quotes.
#  3. The model must be served by an Inference Provider: check https://router.huggingface.co/v1/models
#     (Qwen/Qwen2.5-7B-Instruct, the original default, no longer is).
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ====== DATABASE CONFIGURATION (MariaDB) ======
# These credentials are used by both the backend and MariaDB container
# Change these to secure values for production!
MARIADB_HOST=db
MARIADB_PORT=3306
MARIADB_DATABASE=seismic_db
MARIADB_USER=seismic_user
MARIADB_PASSWORD=seismic_password_2025
MARIADB_ROOT_PASSWORD=root_password_2025

# ====== BACKEND API CONFIGURATION ======
# USGS API endpoint for earthquake data
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
# How often to poll USGS for new events (in seconds)
POLLING_INTERVAL_SECONDS=180
# FastAPI server host and port (inside Docker)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Log every SQL statement (debugging only; very noisy)
SQL_ECHO=false

# ====== INTERNAL DOCKER NETWORKING ======
# Used for container-to-container communication inside Docker
# These use the Docker service name "backend" which only works within the Docker network
BACKEND_INTERNAL_URL=http://backend:8000
BACKEND_PORT=8000

# ====== CORS CONFIGURATION ======
# Allowed origins for CORS (comma-separated). 8081 is Expo on the web (npx expo start --web)
CORS_ORIGINS=http://localhost:3000,http://frontend:3000,http://localhost:3001,http://backend:8000,http://localhost:8081

# ====== FRONTEND CONFIGURATION (Next.js) ======
# The browser calls the API directly, so this must be an address the BROWSER can reach:
# http://localhost:8000 (the port published by the backend). Do not use http://backend:8000:
# that name only exists inside the Docker network and the page would fail to load events.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ====== MOBILE APP CONFIGURATION (Expo) ======
# The phone app finds the API by itself: it takes the address of the Expo server (your PC) and adds port 8000
# (mobile/lib/direccion.ts). Nothing here is needed to run `npx expo start` in mobile/.
#
# Only if you use the `mobile` service of docker-compose: the container does not know your PC's LAN address,
# so write it here for Expo to advertise it in the QR code. Find it with ipconfig (Windows) or ifconfig.
LAN_IP=
#
# Optional: force the API address (for example when the API is not on port 8000 or runs on another machine).
# The WebSocket address is derived from it (/ws). Leave empty to use the automatic one.
EXPO_PUBLIC_API_URL=
